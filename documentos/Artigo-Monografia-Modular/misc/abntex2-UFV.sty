% ---
% VERSÃO DA ABNT PARA CITAÇÕES E REFERÊNCIAS
%
%   \usepackage[abnt=2023]{misc/abntex2-UFV}
%
%   abnt=2023  NBR 10520:2023 + NBR 6023:2018 (biblatex-abnt, Biber) - padrão
%   abnt=2018  NBR 10520:2002 + NBR 6023:2018 (biblatex-abnt, Biber)
%   abnt=2002  NBR 10520:2002 + NBR 6023:2002 (abntex2cite, BibTeX)
%
% A macro \ABNTversao, se definida antes do \documentclass (por exemplo,
% latexmk -usepretex='\def\ABNTversao{2002}'), tem precedência sobre a opção.
% ---
\RequirePackage{kvoptions}
\SetupKeyvalOptions{family=UFV,prefix=UFV@}
\DeclareStringOption[2023]{abnt}
\ProcessKeyvalOptions*

\ifdefined\ABNTversao
  \edef\UFV@abnt{\ABNTversao}
\fi

\def\UFV@versaoA{2002}
\def\UFV@versaoB{2018}
\def\UFV@versaoC{2023}
\ifx\UFV@abnt\UFV@versaoA\else
\ifx\UFV@abnt\UFV@versaoB\else
\ifx\UFV@abnt\UFV@versaoC\else
  \PackageError{abntex2-UFV}{Versão da ABNT inválida: '\UFV@abnt'}{%
    Use abnt=2002, abnt=2018 ou abnt=2023.}
  \let\UFV@abnt\UFV@versaoC
\fi\fi\fi

\edef\imprimirversaoabnt{\UFV@abnt}
\PackageInfo{abntex2-UFV}{Citações e referências conforme ABNT \UFV@abnt}

\ifx\UFV@abnt\UFV@versaoA
  % NBR 10520:2002 e NBR 6023:2002
  \RequirePackage[alf,abnt-emphasize=bf]{abntex2cite}
  \newcommand{\arquivoreferencias}[1]{\gdef\UFV@arquivobib{#1}}
  \newcommand{\imprimirreferencias}{\bibliography{\UFV@arquivobib}}
\else
  % NBR 6023:2018; citações conforme NBR 10520:2023 ou, com accite, 2002
  \RequirePackage{csquotes}
  \ifx\UFV@abnt\UFV@versaoB
    \RequirePackage[style=abnt,backend=biber,extradate,uniquelist=false,accite]{biblatex}
  \else
    \RequirePackage[style=abnt,backend=biber,extradate,uniquelist=false]{biblatex}
  \fi
  \newcommand{\arquivoreferencias}[1]{\addbibresource{#1.bib}}
  \newcommand{\imprimirreferencias}{\printbibliography[heading=bibintoc,title={Referências}]}
  % Comandos do abntex2cite, para o mesmo texto compilar em qualquer versão
  \providecommand{\citeonline}{\textcite}
  \providecommand{\apudonline}{\textapud}
\fi

% Quadro: ilustração com informação textual (NBR 14724).
% Uso: \begin{quadro} \caption{...} ... \fonte{...} \end{quadro}
% Lista: \listofquadros*
% Definido como o \newfloat do memoir, sem chamá-lo: o pacote float (carregado
% por minted, algorithm etc.) substitui \newfloat por outro com outra sintaxe.
\@ifundefined{quadro}{%
  % tipo de flutuante (potência de 2) livre também para o pacote float
  \@ifundefined{c@float@type}{}{%
    \ifnum\value{float@type}>\value{newflo@tctr}%
      \setcounter{newflo@tctr}{\value{float@type}}\fi}%
  \expandafter\edef\csname ftype@quadro\endcsname{\the\c@newflo@tctr}%
  \advance\c@newflo@tctr \c@newflo@tctr
  \@ifundefined{c@float@type}{}{\setcounter{float@type}{\value{newflo@tctr}}}%
  \newcounter{quadro}%
  \@namedef{ext@quadro}{loq}%
  \@ifundefined{c@loqdepth}{\newcounter{loqdepth}}{}%
  \setcounter{loqdepth}{1}%
  \@namedef{fps@quadro}{tbp}%
  \@namedef{fnum@quadro}{Quadro~\thequadro}%
  \@namedef{flegquadro}{Quadro}%
  \@namedef{flegtocquadro}#1{}%
  \newenvironment{quadro}{\@float{quadro}}{\end@float}%
  \newenvironment{quadro*}{\@dblfloat{quadro}}{\end@dblfloat}%
  \newlistof{listofquadros}{loq}{Lista de quadros}%
  \newlistentry{quadro}{loq}{0}%
  \renewcommand*{\cftquadroname}{Quadro\space}%
  \renewcommand*{\cftquadroaftersnum}{\hfill\textendash\hfill}%
  \providecommand*{\quadroautorefname}{Quadro}%
}{}

% Ajusta as margens
\setlrmarginsandblock{3cm}{2cm}{*}
\setulmarginsandblock{3cm}{2cm}{*}
\checkandfixthelayout

% Ajusta identação do parágrafo
\setlength{\parindent}{1.3cm}

% Ajusta o espaçamento entre um parágrafo e outro
\setlength{\parskip}{0.2cm}  % tente também \onelineskip

